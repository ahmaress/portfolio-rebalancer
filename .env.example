# Server Configuration
SERVER_PORT=8080
# Maximum accepted request body size in bytes (default 1 MiB)
MAX_BODY_BYTES=1048576

# Authentication
# HS256 signing secret for bearer tokens; at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Set to true ONLY for local experiments: every request is treated as admin.
AUTH_DISABLED=false

# Elasticsearch Configuration
# Password for the built-in "elastic" user (used by docker compose).
ELASTIC_PASSWORD=change-me-elastic-password
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me-elastic-password
# Optional prefix for index names (e.g. "staging_")
ELASTICSEARCH_INDEX_PREFIX=

# Kafka Configuration
# Comma-separated list. From the host use localhost:19092; inside compose, kafka:9092.
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=rebalance-events
KAFKA_DLQ_TOPIC=rebalance-events-dlq
KAFKA_RESULTS_TOPIC=rebalance-results
KAFKA_CONSUMER_GROUP=portfolio-rebalancer
